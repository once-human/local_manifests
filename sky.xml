<?xml version="1.0" encoding="UTF-8"?>
<!--
  PixelOS 17 (Android 17) for Xiaomi sky: Redmi 12 5G / POCO M6 Pro 5G / Redmi Note 12R
  Linux 6.6 (Nimbus kernel). Trees are LineageOS-style (xiaomi-ravelin sm4450 bring-up)
  carrying our own changes on the "seventeen" branch.

  vendor/xiaomi/sky and vendor/xiaomi/sm4450-common are NOT synced: the build script
  extracts them from Xiaomi's stock ROMs (sky OS2.0.210.0.VMWMIXM, mist OS3.0.306.0.WPUINXM).
  The October (5.10, TopexGuy) setup lives on the seventeen-5.10 branch.
-->
<manifest>
  <remote name="sky-gh" fetch="https://github.com" />

  <!-- device -->
  <project path="device/xiaomi/sky" name="once-human/android_device_xiaomi_sky" remote="sky-gh" revision="seventeen" />
  <project path="device/xiaomi/sm4450-common" name="once-human/android_device_xiaomi_sm4450-common" remote="sky-gh" revision="seventeen" />

  <!-- kernel (6.6) -->
  <project path="kernel/xiaomi/sm4450" name="once-human/android_kernel_xiaomi_sm4450" remote="sky-gh" revision="seventeen" clone-depth="1" />
  <project path="kernel/xiaomi/sm4450-modules" name="once-human/android_kernel_xiaomi_sm4450-modules" remote="sky-gh" revision="seventeen" clone-depth="1" />
  <project path="kernel/xiaomi/sm4450-devicetrees" name="once-human/android_kernel_xiaomi_sm4450-devicetrees" remote="sky-gh" revision="seventeen" clone-depth="1" />

  <!-- hardware: LineageOS hardware/xiaomi + our fingerprint crash fix -->
  <project path="hardware/xiaomi" name="once-human/android_hardware_xiaomi" remote="sky-gh" revision="seventeen-6.6" />
</manifest>
